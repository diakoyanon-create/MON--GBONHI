# Copier ce fichier en .env.local et compléter avec les valeurs de VOTRE projet Supabase.
# Seules l'URL du projet et la clé PUBLIQUE "anon" vont ici : elles sont destinées au navigateur
# et la sécurité repose sur les politiques RLS.
# NE JAMAIS mettre la clé service_role ni aucun autre secret dans une variable VITE_*.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=cle-publique-anon
# URL publique du site (pour le sitemap et les balises Open Graph)
VITE_SITE_URL=https://votre-site.pages.dev
